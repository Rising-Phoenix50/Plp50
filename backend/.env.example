# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (Neon Postgres) ---
# Pooled connection — used by the app at runtime (PgBouncer-compatible, via ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/northstar?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection — used ONLY by Prisma Migrate (migrations cannot run through the pooler)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/northstar?sslmode=require"

# --- Upstream carrier / order-of-record system ---
CARRIER_API_KEY="replace-me"
CARRIER_API_BASE_URL="https://api.example-carrier.com"

# --- Auth ---
# Shared secret used to verify rep session tokens (stubbed for sprint — swap for real SSO/JWT verification later)
REP_SESSION_SECRET="replace-with-a-long-random-string"

# --- CORS ---
# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS="http://localhost:5173,https://support.northstar.example.com"
