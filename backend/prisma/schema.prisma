generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id              String           @id @default(cuid())
  externalOrderId String           @unique
  customerEmail   String
  status          OrderStatus
  carrier         String?
  trackingNumber  String?
  placedAt        DateTime
  eta             DateTime?
  cachedAt        DateTime         @updatedAt
  auditLogs       LookupAuditLog[]
  items           OrderItem[]
  returns         Return[]
  trackingEvents  TrackingEvent[]
  supportReports  SupportReport[]

  @@index([customerEmail])
  @@index([externalOrderId])
}

model OrderItem {
  id      String     @id @default(cuid())
  orderId String
  sku     String
  name    String
  status  ItemStatus
  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model TrackingEvent {
  id         String             @id @default(cuid())
  orderId    String
  title      String
  location   String
  latitude   Float
  longitude  Float
  occurredAt DateTime
  state      TrackingEventState @default(DONE)
  sequence   Int
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sequence])
}

model Return {
  id                String       @id @default(cuid())
  orderId           String
  status            ReturnStatus @default(REQUESTED)
  reason            String?
  refundAmountCents Int?
  initiatedAt       DateTime     @default(now())
  estimatedRefundAt DateTime?
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SupportReport {
  id        String    @id @default(cuid())
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorType ActorType
  repEmail  String?
  email     String?
  message   String
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model LookupAuditLog {
  id        String      @id @default(cuid())
  orderId   String?
  actorType ActorType
  repEmail  String?
  action    AuditAction
  timestamp DateTime    @default(now())
  ipAddress String?
  requestId String?
  order     Order?      @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([repEmail])
  @@index([timestamp])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  PARTIALLY_SHIPPED
  DELIVERED
  CANCELLED
}

enum ItemStatus {
  PENDING
  SHIPPED
  DELIVERED
}

enum TrackingEventState {
  DONE
  CURRENT
  PENDING
}

enum ReturnStatus {
  REQUESTED
  REFUND_PENDING
  REFUNDED
  DENIED
}

enum ActorType {
  CUSTOMER
  REP
}

enum AuditAction {
  ORDER_LOOKUP
  ORDER_LOOKUP_DENIED
  TRACKING_VIEWED
  RETURN_INITIATED
  ORDER_LOOKUP_FAILED
}
